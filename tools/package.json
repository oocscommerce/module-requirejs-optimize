{
  "name": "oocs-requirejs-optimize",
  "version": "1.0.0",
  "private": true,
  "description": "Static RequireJS graph analyzer and bundler for Magento 2 deployed static content",
  "type": "commonjs",
  "bin": {
    "rjs-optimize": "bin/rjs-optimize.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "fast-xml-parser": "^5.11.2",
    "terser": "^5.51.2"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "scripts": {
    "dist": "esbuild bin/rjs-optimize.js --bundle --platform=node --target=node18 --minify --legal-comments=eof --outfile=dist/rjs-optimize.js"
  }
}
